---
import BaseLayout from '../layouts/BaseLayout.astro';

const actionLinks = [
  {
    title: 'WhatsApp',
    href: 'https://wa.me/5554996415665?text=Olá! Gostaria de falar com a Partiu Viagem.',
    style: 'top: 36.9%; left: 1.8%; width: 56.2%; height: 9.8%;',
  },
  {
    title: 'Site',
    href: 'https://www.partiuviagem.tur.br/',
    style: 'top: 47.7%; left: 1.8%; width: 56.2%; height: 9.8%;',
  },
  {
    title: 'Facebook',
    href: 'https://www.facebook.com/PartiuViagemTurismo',
    style: 'top: 58.8%; left: 1.8%; width: 56.2%; height: 9.8%;',
  },
  {
    title: 'Instagram',
    href: 'https://www.instagram.com/partiuviagemturismo',
    style: 'top: 69.9%; left: 1.8%; width: 56.2%; height: 9.8%;',
  },
];
---

<BaseLayout
  title="Link | Partiu Viagem"
  description="Acesse rapidamente os principais canais da Partiu Viagem: WhatsApp, site, Facebook, Instagram e atendimento personalizado."
  image="/images/logopartiuviagem.png"
  keywords={['Partiu Viagem', 'Link', 'WhatsApp', 'Instagram', 'Facebook', 'Turismo']}
>
  <main class="link-page block overflow-x-hidden bg-transparent p-0 lg:flex lg:justify-center">
    <section class="relative w-full self-start lg:w-[800px] lg:max-w-[800px]">
      <img
        src="/images/card_pv1.jpg"
        alt="Card Partiu Viagem com links principais"
        class="block h-auto w-full"
      />

      {actionLinks.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.title}
          title={item.title}
          class="link-hotspot absolute block rounded-[999px]"
          style={item.style}
        >
          <span class="sr-only">{item.title}</span>
        </a>
      ))}

      <a
        href="https://www.partiuviagem.tur.br/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Partiu Viagem"
        title="Partiu Viagem"
        class="link-hotspot absolute block rounded-[32px]"
        style="top: 4.8%; left: 2.2%; width: 32%; height: 23%;"
      >
        <span class="sr-only">Partiu Viagem</span>
      </a>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  document.body.classList.add('hide-whatsapp-on-link');
</script>

<style is:global>
  .link-page {
    margin: 0 !important;
  }

  .hide-whatsapp-on-link .whatsapp-button {
    display: none !important;
  }

  .link-page .link-hotspot {
    background: transparent;
    outline: none;
    box-shadow: none !important;
    transition: none;
  }

  .link-page .link-hotspot:hover,
  .link-page .link-hotspot:focus-visible {
    box-shadow: none !important;
    background-color: transparent !important;
    outline: none !important;
  }
</style>
