---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allImages = Array.from({ length: 10 }, (_, index) =>
  `/images/quem-somos/quemsomos%20(${index + 1}).jpeg`
);

const heroImages = allImages.slice(0, 4);
const galleryImages = allImages.filter((_, index) => index !== 5 && index !== 7);

const timelineItems = [
  {
    year: '2017',
    title: 'Graduação em Turismo',
    description:
      'Bacharelado pela Feevale, dando início à construção de uma carreira dedicada ao desenvolvimento do turismo.',
  },
  {
    year: '2018',
    title: 'Fundação da Partiu Viagem Turismo',
    description:
      'Agência criada com o propósito de democratizar o acesso às viagens e proporcionar experiências inesquecíveis.',
  },
  {
    year: '2019',
    title: 'Guia de Turismo - América do Sul',
    description:
      'Formação pelo SENAC, ampliando a atuação profissional e o conhecimento técnico sobre destinos e experiências.',
  },
  {
    year: '2021',
    title: 'MBA e Mestrado',
    description:
      'Conclusão do MBA em Gestão de Negócios em Turismo, pela UNIRITTER, e obtenção do título de Mestre em Turismo e Hospitalidade, pela UCS.',
  },
  {
    year: '2021 - 2024',
    title: 'Secretário Municipal de Turismo',
    description:
      'Atuação em Nova Petrópolis, contribuindo para o fortalecimento de um dos principais destinos turísticos da Serra Gaúcha.',
  },
  {
    year: '2024 - Atual',
    title: 'Diretor Adjunto de Planejamento e Competitividade',
    description:
      'Atuação na Secretaria de Turismo do Estado do Rio Grande do Sul, participando da formulação de políticas públicas e estratégias para o desenvolvimento do turismo gaúcho.',
  },
  {
    year: '2026',
    title: 'Ampliação da Partiu Viagem Receptivo',
    description:
      'Ampliação da atuação da marca para receber visitantes e apresentar, com autenticidade, as riquezas culturais, históricas e naturais da Serra Gaúcha e do Rio Grande do Sul.',
  },
  {
    year: 'Atualidade',
    title: 'Professor e Palestrante',
    description:
      'Compartilha conhecimentos, experiências e reflexões sobre turismo, gestão, hospitalidade e desenvolvimento de destinos, além de atuar como Professor de Turismo do RECIDADES Brasil.',
  },
];
---

<BaseLayout
  title="Nossa História | Partiu Viagem"
  description="Conheça a trajetória da Partiu Viagem e de Rodrigo Santos, profissional que une formação, experiência e paixão pelo turismo para criar experiências autênticas."
  image={heroImages[0]}
  keywords={['Partiu Viagem', 'Rodrigo Santos', 'Turismo', 'Nossa História', 'Serra Gaúcha', 'Rio Grande do Sul']}
>
  <Header />

  <section class="relative min-h-[85vh] overflow-hidden">
    <div class="carousel-container absolute inset-0">
      {heroImages.map((image, index) => (
        <div class={`carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100' : 'opacity-0'}`}>
          <img
            src={image}
            alt="Partiu Viagem - Nossa história"
            class="h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-slate-950/50"></div>
        </div>
      ))}
    </div>

    <div class="relative z-10 flex min-h-[85vh] items-center">
      <div class="mx-auto max-w-6xl px-4 py-24 text-white">
        <div class="max-w-4xl">
          <span class="mb-6 inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium backdrop-blur-sm">
            Quem Somos
          </span>
          <h1 class="mb-6 text-4xl font-bold leading-tight md:text-6xl lg:text-7xl">
            Partiu Viagem:
            <span class="block text-amber-300">experiências que conectam pessoas</span>
          </h1>
          <p class="max-w-3xl text-lg leading-relaxed text-slate-100 md:text-2xl">
            Mais do que vender viagens, construímos vivências autênticas, com atendimento próximo,
            cuidado em cada detalhe e compromisso com um turismo responsável, acolhedor e cheio de significado.
          </p>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 z-20 flex -translate-x-1/2 gap-3">
      {heroImages.map((_, index) => (
        <button
          class={`carousel-indicator h-3 w-3 rounded-full bg-white transition-opacity duration-300 ${index === 0 ? 'opacity-100' : 'opacity-50'}`}
          data-slide={index}
          aria-label={`Ir para a imagem ${index + 1}`}
        ></button>
      ))}
    </div>

    <button class="carousel-prev absolute left-4 top-1/2 z-20 -translate-y-1/2 rounded-full bg-white/10 p-3 text-white backdrop-blur-sm transition hover:bg-white/20">
      <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>
    <button class="carousel-next absolute right-4 top-1/2 z-20 -translate-y-1/2 rounded-full bg-white/10 p-3 text-white backdrop-blur-sm transition hover:bg-white/20">
      <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </section>

  <section class="bg-white py-20 dark:bg-gray-900">
    <div class="mx-auto grid max-w-6xl gap-14 px-4 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <div class="mb-8">
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white md:text-5xl">
            Quem <span class="text-blue-600">Somos</span>
          </h2>
          <div class="mt-4 h-1 w-20 bg-blue-600"></div>
        </div>

        <div class="space-y-6 text-lg leading-relaxed text-gray-600 dark:text-gray-300">
          <p>
            A <strong class="text-gray-900 dark:text-white">Partiu Viagem</strong> nasceu do sonho de transformar
            viagens em experiências capazes de conectar pessoas, criar memórias e valorizar os destinos por meio de
            um turismo responsável, acolhedor e cheio de significado.
          </p>
          <p>
            Por trás dessa trajetória está <strong class="text-gray-900 dark:text-white">Rodrigo Santos</strong>,
            turismólogo, mestre, guia de turismo, gestor público, professor e palestrante, que construiu sua caminhada
            unindo conhecimento técnico, experiência prática e paixão por mostrar o melhor de cada destino.
          </p>
          <p>
            Mais do que vender viagens, acreditamos em proporcionar vivências autênticas, com cuidado em cada detalhe,
            atendimento próximo e o compromisso de fazer com que cada passageiro se sinta parte da nossa história.
          </p>
          <p>
            Ao longo dos anos, milhares de viajantes embarcaram conosco, fortalecendo uma marca que hoje atua tanto no
            turismo emissivo quanto no receptivo, sempre guiada pela ética, profissionalismo e amor pelo turismo.
          </p>
        </div>

        <div class="mt-10 rounded-3xl border border-blue-100 bg-gradient-to-r from-blue-50 to-indigo-50 p-8 dark:border-gray-700 dark:from-gray-800 dark:to-gray-800">
          <h3 class="mb-4 text-2xl font-semibold text-gray-900 dark:text-white">
            Partiu Viagem: mais do que viagens, experiências que conectam pessoas e transformam histórias.
          </h3>
          <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300">
            Com profissionalismo, acolhimento e paixão pelo que fazemos, seguimos construindo novos caminhos,
            inspirando descobertas e levando cada viajante a viver momentos únicos, porque acreditamos que viajar é
            uma das formas mais bonitas de conhecer o mundo e também de transformar vidas.
          </p>
        </div>
      </div>

      <div class="space-y-6">
        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-2xl bg-gradient-to-br from-blue-600 to-blue-700 p-6 text-white shadow-lg">
            <div class="text-3xl font-bold">2018</div>
            <div class="mt-2 text-sm text-blue-100">Fundação da Partiu Viagem Turismo</div>
          </div>
          <div class="rounded-2xl bg-gradient-to-br from-indigo-600 to-indigo-700 p-6 text-white shadow-lg">
            <div class="text-3xl font-bold">2026</div>
            <div class="mt-2 text-sm text-indigo-100">Início da Partiu Viagem Receptivo</div>
          </div>
          <div class="rounded-2xl bg-gradient-to-br from-slate-700 to-slate-800 p-6 text-white shadow-lg">
            <div class="text-xl font-semibold">Emissivo e receptivo</div>
            <div class="mt-2 text-sm text-slate-200">Atuação completa para diferentes perfis de viajantes</div>
          </div>
          <div class="rounded-2xl bg-gradient-to-br from-amber-500 to-orange-500 p-6 text-white shadow-lg">
            <div class="text-xl font-semibold">Turismo com propósito</div>
            <div class="mt-2 text-sm text-amber-50">Experiências autênticas com cuidado em cada detalhe</div>
          </div>
        </div>

        <div class="overflow-hidden rounded-3xl bg-gray-50 shadow-lg dark:bg-gray-800">
          <img
            src={allImages[4]}
            alt="Rodrigo Santos e equipe da Partiu Viagem"
            class="h-80 w-full object-cover"
          />
          <div class="p-6">
            <h3 class="mb-3 text-xl font-semibold text-gray-900 dark:text-white">Nossa essência</h3>
            <ul class="space-y-3 text-gray-600 dark:text-gray-300">
              <li class="flex items-start gap-3">
                <span class="mt-1 h-2.5 w-2.5 rounded-full bg-blue-600"></span>
                Atendimento próximo e acolhedor.
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1 h-2.5 w-2.5 rounded-full bg-blue-600"></span>
                Planejamento com visão técnica e experiência prática.
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1 h-2.5 w-2.5 rounded-full bg-blue-600"></span>
                Compromisso com ética, profissionalismo e desenvolvimento do turismo.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-20 dark:bg-gray-950">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-14 text-center">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white md:text-5xl">
          Nossa <span class="text-blue-600">Trajetória</span>
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-gray-600 dark:text-gray-300">
          Uma caminhada construída com formação, atuação profissional e dedicação ao fortalecimento do turismo.
        </p>
      </div>

      <div class="relative">
        <div class="absolute left-4 top-0 hidden h-full w-1 bg-blue-200 md:left-1/2 md:block md:-translate-x-1/2 dark:bg-blue-900/40"></div>

        <div class="space-y-8">
          {timelineItems.map((item, index) => (
            <div class={`relative md:grid md:grid-cols-2 md:gap-10 ${index % 2 === 0 ? '' : ''}`}>
              <div class={index % 2 === 0 ? 'md:pr-10 md:text-right' : 'md:col-start-2 md:pl-10'}>
                <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900">
                  <span class="mb-4 inline-flex rounded-full bg-blue-100 px-4 py-2 text-sm font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-200">
                    {item.year}
                  </span>
                  <h3 class="mb-3 text-2xl font-semibold text-gray-900 dark:text-white">{item.title}</h3>
                  <p class="leading-relaxed text-gray-600 dark:text-gray-300">{item.description}</p>
                </div>
              </div>

              <div class="hidden md:block"></div>
              <div class="absolute left-1/2 top-10 hidden h-5 w-5 -translate-x-1/2 rounded-full border-4 border-white bg-blue-600 md:block dark:border-gray-950"></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 dark:bg-gray-900">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white md:text-5xl">
            Galeria de <span class="text-blue-600">imagens</span>
          </h2>
          <p class="mt-4 max-w-2xl text-lg text-gray-600 dark:text-gray-300">
            Conheça alguns dos momentos que fazem parte da história da Partiu Viagem. Registros de eventos, experiências e conquistas que refletem nosso compromisso com a excelência, a inovação e o turismo de qualidade.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {galleryImages.map((image, index) => (
          <figure class="overflow-hidden rounded-3xl bg-gray-100 shadow-sm dark:bg-gray-800">
            <img
              src={image}
              alt={`em ${index + 1}`}
              class="h-72 w-full object-cover transition duration-500 hover:scale-105"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-blue-900 py-20 text-white">
    <div class="absolute inset-0 opacity-20" style={`background-image: url('${allImages[1]}'); background-size: cover; background-position: center;`}></div>
    <div class="relative mx-auto max-w-6xl px-4">
      <div class="grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="overflow-hidden rounded-3xl border border-white/10 bg-white/10 p-3 backdrop-blur-sm">
          <img
            src={allImages[3]}
            alt="Partiu Viagem em atuação"
            class="h-80 w-full rounded-2xl object-cover lg:h-[420px]"
          />
        </div>

        <div>
          <span class="mb-5 inline-flex rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium">
            Fale com a Partiu Viagem
          </span>
          <h2 class="text-4xl font-bold leading-tight md:text-5xl">
            Vamos construir sua próxima experiência juntos?
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-200">
            Seja para viagens, receptivo, experiências culturais ou projetos ligados ao turismo, a Partiu Viagem
            segue de portas abertas para atender com proximidade, planejamento e compromisso com a excelência.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="https://wa.me/5554996415665?text=Olá! Gostaria de saber mais sobre a Partiu Viagem e seus serviços."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-full bg-green-500 px-8 py-4 text-lg font-semibold text-white transition hover:bg-green-600"
            >
              Falar no WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script is:inline>
  let currentSlide = 0;
  const slides = Array.from(document.querySelectorAll('.carousel-slide'));
  const indicators = Array.from(document.querySelectorAll('.carousel-indicator'));
  const nextButton = document.querySelector('.carousel-next');
  const prevButton = document.querySelector('.carousel-prev');
  const totalSlides = slides.length;
  let autoplayId = null;

  function showSlide(index) {
    slides.forEach((slide, slideIndex) => {
      slide.style.opacity = slideIndex === index ? '1' : '0';
    });

    indicators.forEach((indicator, indicatorIndex) => {
      indicator.style.opacity = indicatorIndex === index ? '1' : '0.5';
    });
  }

  function nextSlide() {
    currentSlide = (currentSlide + 1) % totalSlides;
    showSlide(currentSlide);
  }

  function prevSlide() {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    showSlide(currentSlide);
  }

  function restartAutoplay() {
    if (autoplayId) clearInterval(autoplayId);
    autoplayId = setInterval(nextSlide, 5000);
  }

  if (nextButton && prevButton && totalSlides > 0) {
    nextButton.addEventListener('click', () => {
      nextSlide();
      restartAutoplay();
    });

    prevButton.addEventListener('click', () => {
      prevSlide();
      restartAutoplay();
    });

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        currentSlide = index;
        showSlide(currentSlide);
        restartAutoplay();
      });
    });

    restartAutoplay();
  }
</script>
